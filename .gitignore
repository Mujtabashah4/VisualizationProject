# ============================================
# YouTube Viral Intelligence Project
# .gitignore - Root Level
# ============================================

# ============================================
# Python
# ============================================
# Virtual environments
venv/
env/
ENV/
.venv/
.ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# ============================================
# Node.js / Frontend
# ============================================
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Next.js
.next/
out/
build/
dist/

# Production
*.log
*.pid
*.seed
*.pid.lock

# ============================================
# Environment Variables
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ============================================
# IDE / Editor
# ============================================
# VSCode
.vscode/
*.code-workspace

# IntelliJ / PyCharm
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ============================================
# OS Files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ============================================
# Large Data Files
# ============================================
# Parquet files (large datasets)
*.parquet
*.parquet.gz

# Large model files (keep small ones, ignore large ones)
# Uncomment if models are too large for git
# *.pkl
# *.h5
# *.hdf5
# *.joblib

# Large data files
*.csv.gz
*.csv.zip
*.tsv.gz

# ============================================
# Project Specific
# ============================================
# Backend
Backend/venv/
Backend/__pycache__/
Backend/*.pyc
Backend/.pytest_cache/

# Frontend
Frontend/node_modules/
Frontend/.next/
Frontend/out/
Frontend/.turbo/
Frontend/.vercel/

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# Lock Files (Optional - uncomment if you want to ignore)
# ============================================
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# poetry.lock

# ============================================
# Build artifacts
# ============================================
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# ============================================
# Database
# ============================================
*.db
*.sqlite
*.sqlite3

# ============================================
# Miscellaneous
# ============================================
# Screenshots (keep only important ones)
# Uncomment if you want to ignore all screenshots
# *.png
# *.jpg
# *.jpeg

# Keep important images
!images/dashboard/*.png
!images/ml/*.png
!images/eda/*.png

# Ignore temporary screenshots
images/dashboard/Screenshot*.png

# Keep documentation images
!*.md
!README.md
!FINAL_BLOG_POST.md

